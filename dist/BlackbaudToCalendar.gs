      .replace(/<\s*(script|style)[^>]*>[\s\S]*?<\s*\/\s*\1\s*>/gi, '')
      .replace(/<\s*br\s*\/?\s*>/gi, '\n')
      .replace(/<\s*li[^>]*>/gi, '\n• ')
      .replace(/<\s*\/\s*(p|div|ul|ol|h[1-6]|tr|table)\s*>/gi, '\n')
      .replace(/<[^>]+>/g, '');
